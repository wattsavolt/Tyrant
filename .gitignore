# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Fortran module files
*.mod
*.smod

# Executables
*.exe
*.out
*.app

# AppStudio Intermediate File
*.aps

# Claude Code
.claude/

# ImGui window-layout state - generated per machine/session, not source
imgui.ini

# SDKs whose licences don't allow sharing them, such as FMOD. CMake copies them in from where
# their installers put them, on each machine that has them.
ThirdParty/Licensed/

# Anything else from FMOD: its libraries, Studio projects and built banks. The engine's own
# FMOD backend source in Engine/Runtime/Audio/FMOD is ours and stays tracked.
*[Ff][Mm][Oo][Dd]*.dll
*[Ff][Mm][Oo][Dd]*.lib
*.fspro
*.bank
